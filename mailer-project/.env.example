# Show error details in API responses (1 = on, 0 = off)
APP_DEBUG=1

# Secret the browser must send in the "Api-Key" header (set it on the /api-key page)
API_KEY=change-me

# SMTP server, e.g. Office 365 = smtp.office365.com, port 587, encryption tls
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
# tls, ssl or empty for none
MAIL_ENCRYPTION=tls
# Leave empty if the server needs no login
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Mailer"
