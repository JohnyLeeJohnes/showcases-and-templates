# API configuration
API_PORT=3000
API_PREFIX=/api/v1
NODE_ENV=development

# Swagger configuration (SWAGGER_ENABLE: 1 = on, 0 = off)
SWAGGER_ENABLE=1
SWAGGER_TITLE='Test template API'
SWAGGER_DESCRIPTION='API template'
SWAGGER_PREFIX='/api'

# Database configuration
# localhost = MySQL from docker compose, reached from your machine
# (the api container in docker compose overrides it to "db")
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=db_test
DATABASE_USERNAME=root
DATABASE_PASSWORD=1234
